{
  "name": "@freesyntax/notch-cli",
  "version": "0.7.23",
  "description": "Notch CLI — AI-powered coding assistant by Driftrail",
  "type": "module",
  "bin": {
    "notch": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup --dts",
    "build:publish": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "benchmark:startup": "node scripts/benchmark-startup.mjs",
    "evaluate:local": "node scripts/evaluate-local-agent.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run build:publish"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/openai": "^4.0.92",
    "@earendil-works/pi-ai": "^1.2.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "^7.0.138",
    "ajv": "^8.20.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "ignore": "^6.0.2",
    "minimatch": "^10.2.6",
    "ora": "^8.1.1",
    "simple-git": "^4.0.2",
    "smol-toml": "^1.6.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "Apache-2.0",
  "author": "Driftrail <hello@driftrail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simpleending/FreeSyntax.git",
    "directory": "notch-cli"
  },
  "keywords": [
    "ai",
    "coding",
    "cli",
    "notch",
    "driftrail"
  ]
}
